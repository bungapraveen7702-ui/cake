pipeline{
    agent any 
    environment {
        APP_NAME = 'cake'
    }
    option{
            timestamps()
    disableConcurrentBuilds()
    
    }
    stages{
        stage('checkout'){
            steps{
                checkout scm
            }
        }
        }
        stage ('install dependencies'){
            steps{
                sh npm install 

            }
        }
        stage('start application'){
            steps{
                sh npm start
            }
        }
        stage('test'){
            steps{
                sh npm test
            }
        }
        stage('build'){
            step{
                sh npm build
            }
        }
    }

}